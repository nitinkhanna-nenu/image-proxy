# Copy to .env and fill in. deploy.sh reads this file. .env stays out of git
# when this directory is used from the image-proxy repo (.gitignore covers .env).

IMAGE_PROXY_BIND_ADDRESS=0.0.0.0:8000
RUST_LOG=info

# One bucket for Prexels originals. The key for GET /photo.jpg is
# <IMAGE_PROXY_S3_PREFIX>/photo.jpg.
IMAGE_PROXY_S3_BUCKET=prexels-photos
IMAGE_PROXY_S3_REGION=us-east-1
IMAGE_PROXY_S3_PREFIX=originals

# Static keys. A security token (STS session token) needs the key and the secret too.
# Leave all three unset to use the default AWS chain: IAM role, web identity, or
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN.
IMAGE_PROXY_S3_ACCESS_KEY_ID=
IMAGE_PROXY_S3_SECRET_ACCESS_KEY=
IMAGE_PROXY_S3_SECURITY_TOKEN=

# Custom endpoint for MinIO, LocalStack, or R2. Path-style defaults to true when this is set.
# IMAGE_PROXY_S3_ENDPOINT=https://s3.example.com
# IMAGE_PROXY_S3_PATH_STYLE=true

# Bearer token the Prexels app sends on PUT /{filename}. One token, no spaces.
IMAGE_PROXY_UPLOAD_TOKEN=replace-me

# Non-image API calls. GET and PUT of an image path stay on this process. /metrics stays here.
# The caller's Authorization header is forwarded. Use https when that header matters.
IMAGE_PROXY_BACKEND_URL=https://api.prexels.example
IMAGE_PROXY_BACKEND_TIMEOUT=30

# OpenTelemetry metrics. The image compiles this in unless CARGO_FEATURES is empty.
# Export stays off unless an endpoint is set. /metrics stays on this process.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_SERVICE_NAME=image-proxy
# DEPLOYMENT_ENVIRONMENT=production

# Transformed responses. Disk cache is off: turn it on only with a directory writable by uid 1000,
# mounted at IMAGE_PROXY_CACHE_DISK_PATH.
IMAGE_PROXY_ENABLE_CACHE=true
IMAGE_PROXY_ENABLE_DISK_CACHE=false
# IMAGE_PROXY_CACHE_DISK_PATH=/var/cache/image-proxy
IMAGE_PROXY_PREFERRED_FORMATS=avif,webp
