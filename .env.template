# Copy to .env before `docker compose up` (compose.yml). .env is gitignored.
# `cargo run` does not read this file.

IMAGE_PROXY_ROOT_PATH=/app/data/images
RUST_LOG=debug

# Where original image bytes live: volume (IMAGE_PROXY_ROOT_PATH), s3, or foyer.
# Unset keeps the old rule: a set IMAGE_PROXY_S3_BUCKET selects s3, otherwise volume.
# IMAGE_PROXY_STORAGE=volume

# Mount one bucket as the image store. Leave the bucket unset to keep ./data/images.
# Set IMAGE_PROXY_STORAGE=s3 when this bucket is the store.
# A security token needs the access key id and the secret as well. Leave all three
# unset to use the default AWS credential chain (IAM role, web identity, or AWS_* keys).
# IMAGE_PROXY_S3_BUCKET=photos
# IMAGE_PROXY_S3_REGION=us-east-1
# IMAGE_PROXY_S3_PREFIX=originals
# IMAGE_PROXY_S3_ENDPOINT=https://s3.example.com
# IMAGE_PROXY_S3_PATH_STYLE=true
# IMAGE_PROXY_S3_ACCESS_KEY_ID=
# IMAGE_PROXY_S3_SECRET_ACCESS_KEY=
# IMAGE_PROXY_S3_SECURITY_TOKEN=
# Bearer token for PUT /{filename}. Unset disables uploads.
# IMAGE_PROXY_UPLOAD_TOKEN=

# Non-image requests are forwarded here. Image GET/PUT and /metrics stay on this process.
# IMAGE_PROXY_BACKEND_URL=https://api.example.com
# IMAGE_PROXY_BACKEND_TIMEOUT=30

# OpenTelemetry metrics. The binary must be built with `--features otel`
# (the Docker image is, unless CARGO_FEATURES is empty). Export stays off
# unless an endpoint is set. /metrics stays on.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_SERVICE_NAME=image-proxy
# DEPLOYMENT_ENVIRONMENT=production

# IMAGE_PROXY_STORAGE=foyer
# IMAGE_PROXY_ENABLE_CACHE=true
# IMAGE_PROXY_ENABLE_DISK_CACHE=true
# IMAGE_PROXY_CACHE_DISK_PATH=/var/cache/image-proxy
# IMAGE_PROXY_PREFERRED_FORMATS=avif,webp